# Приклад змінних середовища бекенду (скопіюйте в backend/.env або задайте в системі)
DATABASE_URL=sqlite:///./codeinspector.db
# для PostgreSQL: postgresql://користувач:пароль@localhost:5432/назва_бази
SECRET_KEY=змініть-на-довгий-випадковий-рядок
APP_ENV=development
SEED_DEMO_DATA=true
CORS_ORIGINS=*
